# Target: 西瓜派 V3 (rockchip/armv8)
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_nlnet_xiguapi-v3=y

# U-Boot
CONFIG_PACKAGE_u-boot-xiguapi-v3-rk3568=y

# 只用 squashfs，禁用 ext4
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y

# LuCI 中文
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 屏幕支持
CONFIG_DISPLAY_SUPPORT=y
CONFIG_PACKAGE_kmod-fb-tft=y
CONFIG_PACKAGE_kmod-fb-tft-gc9307=y
CONFIG_PACKAGE_xgp-v3-screen=y
CONFIG_PACKAGE_luci-app-xgp-v3-screen-brightness=y

# 无线驱动 - MT7922
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_kmod-mt7921-common=y
CONFIG_PACKAGE_kmod-mt7922-firmware=y
CONFIG_PACKAGE_hostapd-openssl=y
CONFIG_PACKAGE_iw=y

# 无线驱动 - Atheros/Qualcomm (NFA765)
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-wcn6855=y
CONFIG_PACKAGE_ath11k-firmware-qca6390=y
CONFIG_PACKAGE_kmod-ath12k=y
CONFIG_PACKAGE_ath12k-firmware-wcn7850=y

# USB 网络 / 5G 模块
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_comgt=y

# 应用
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 工具
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_socat=y

# Docker
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y

# 防火墙
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_iptables-nft=y

# 其他
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-input-adc-keys=y
CONFIG_PACKAGE_kmod-saradc-rockchip=y

# 网络默认配置 (LAN: 10.1.1.1/24, WAN: DHCP)
CONFIG_TARGET_PREINIT_IP="10.1.1.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"

# Nikki/Mihomo removed (recursive dependency in upstream)
# CONFIG_PACKAGE_nikki is not set
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_mihomo-meta is not set
# CONFIG_PACKAGE_mihomo-alpha is not set

# QModem removed (no QMI driver needed)
# CONFIG_PACKAGE_luci-app-qmodem is not set
